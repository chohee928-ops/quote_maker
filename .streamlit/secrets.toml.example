# Streamlit Community Cloud 배포용 설정.
#
# 로컬에서는 .env 를 쓰고, 클라우드에서는 이 값들을
#   App settings -> Secrets
# 에 그대로 붙여넣습니다. .env 와 이름이 같습니다.
#
# 이 파일을 .streamlit/secrets.toml 로 복사해 로컬에서 쓸 수도 있지만,
# secrets.toml 은 .gitignore 에 있으니 커밋되지 않습니다.

DATA_SOURCE = "csv"          # csv | sheets
MOCK_AI = "true"             # true 면 Claude API 를 호출하지 않습니다
ANTHROPIC_API_KEY = ""
CLAUDE_MODEL = "claude-opus-5-5"

GOOGLE_SHEETS_ID = ""

# 클라우드에는 키 파일을 올릴 수 없으므로 JSON 내용을 그대로 넣습니다.
# 서비스 계정 키 파일(service_account.json)을 열어 전체를 복사해 붙여넣으세요.
GOOGLE_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com"
}
'''
