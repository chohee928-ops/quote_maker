# 복사해서 .env 파일로 만들고 값을 채우세요.  cp .env.example .env
# 이 파일에는 실제 값을 넣지 마세요 (git에 커밋되는 템플릿입니다).

# --- 데이터 소스 ---
# csv    : data/ 폴더의 CSV 파일을 읽습니다 (키 없이 바로 실행 가능)
# sheets : Google Sheets를 읽습니다
DATA_SOURCE=csv

# --- Google Sheets (DATA_SOURCE=sheets 일 때만 필요) ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# --- Claude API ---
# true  : API 호출 없이 가짜 응답 사용 (화면에 MOCK 배지가 표시됩니다)
# false : 실제 Claude API 호출 (ANTHROPIC_API_KEY 필요)
MOCK_AI=true
ANTHROPIC_API_KEY=

# 사용할 Claude 모델. 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
